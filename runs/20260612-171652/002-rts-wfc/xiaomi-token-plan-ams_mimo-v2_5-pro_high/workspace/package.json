    "vitest": "^3.0.0",
    "eslint": "^9.0.0",
    "@eslint/js": "^9.0.0",
    "typescript-eslint": "^8.0.0",
    "jsdom": "^26.0.0",
    "@types/jsdom": "^21.0.0"
  },
  "dependencies": {}
}
