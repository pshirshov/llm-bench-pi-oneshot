  },
  "devDependencies": {
    "typescript": "^5.7.0",
    "typescript-eslint": "^8.30.0",
    "vite": "^6.3.0",
    "vitest": "^3.2.0",
    "eslint": "^9.23.0",
    "jsdom": "^26.0.0"
  }
}